{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "全部测试",
      "type": "shell",
      "command": "go test ./... -count=1",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "全部测试（竞态检测）",
      "type": "shell",
      "command": "go test -race ./... -count=1",
      "group": "test",
      "problemMatcher": ["$go"]
    }
  ]
}
